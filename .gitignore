.data/
www/app.js
# node_modules 是软链(→ ../lume/frontend/node_modules), 两种写法都忽略(软链 + 目录)
node_modules
node_modules/
logs/
*.log
.env

# 本机测试脚手架 (mktemp/xcrun shim, 沙箱写 /tmp 被锁时用)
.work-sc/

# Lume 服务启动时 llm-router 自动生成
skills/

# ---- 运行时产物 (make peer-up / agent 启动时生成) ----
# 不加这些规则时, 每跑一次 peer 就有一批未跟踪文件进 git status;
# 一次 `git add .` 就会把本机 pid、日志、临时脚本带进公开仓。
# .runtime/ 里还有 MCP 同步产物和会话数据, 体积也可能很大。
.runtime/
.runtime-*.pid
*_tmp.lume
*_tmp.py

# 手工备份(改 peer_node / repo 前留的副本)。
# 回滚交给 git 历史就够了 —— 两份同构文件必然分叉, 而分叉的表现是
# "改了 A 没改 B", 这个项目已经踩过(镜像里 13KB 的旧 peer.lume)。
*.bak-*
*.bak

# vendor/lume-core/: 由 make vendor / make bootstrap 填充(见 scripts/vendor_lume.sh)。
#   lib/*.lume  入库 —— 解释器按路径读的 .lume 源码, 必须随仓走, 单独 clone 才能 import。
#   bin/lume-core 不入库 —— 二进制体积大、无法 code review; 由 vendor 目标按需拉取。
#   .vendor-stamp 入库 —— 记录这份 vendor 来自哪个版本(bin 版本 + lib tag), 可查可复核。
vendor/lume/bin/
