// src/repo.lume — 领域层: 只读信号扫描 / 规则筛选 / 个股序列 / 数据源元信息
// 纯无状态; 库路径经 env SCANNER_DB / ASSET_DB 指定, make dev 默认指向 .data/。
// 信号「计算」(51 指标 ETL) 在 Python 端 stock-analyzer, 本模块只读其 SQLite 结果列。

// ---- 库路径解析(env 优先, 缺省本地样例) ----
func db_scan() {
  let p = env("SCANNER_DB");
  if (p == null) { return ".data/scanner.db"; }
  return p;
}
func db_asset() {
  let p = env("ASSET_DB");
  if (p == null) { return ".data/asset.db"; }
  return p;
}

// ---- 名称查找: asset_snapshot(asset.db) 用纯 6 位数字 code; 股票库侧带 sh/sz/bj 前缀, 先去掉 ----
func numeric_of(prefixed) {
  let s = str(prefixed);
  if (len(s) == 8) { return substr(s, 2); }
  return s;
}

// codes: 带前缀代码列表 → map(数字代码 → 名称); 一条 IN 查询批量取, 取不到的名称为空串。
func names_map(codes) {
  let nums = [];
  let i = 0;
  while (i < len(codes)) { push(nums, numeric_of(codes[i])); i = i + 1; }
  let by_num = {};
  if (len(nums) == 0) { return by_num; }
  let marks = [];
  i = 0;
  while (i < len(nums)) { push(marks, "?"); i = i + 1; }
  let rows = sql_query(db_asset(),
    "select code, name from asset_snapshot where code in (" + join(marks, ",") + ")", nums);
  i = 0;
  while (i < len(rows)) {
    put(by_num, str(get(rows[i], "code", "")), str(get(rows[i], "name", "")));
    i = i + 1;
  }
  return by_num;
}

// ---- 数据源元信息(最新交易日/标的数/行数) ----
// 5min 缓存: 该查询对 8.5M 行全表 count(*)+count(distinct) 约 0.7s, 而数据每日
// 只变一次 —— 首拉 0.7s, 缓存后 ~1ms。
let META_CACHE = { exp: 0, data: null };
export func meta_payload() {
  if (int(get(META_CACHE, "exp", 0)) >= now() and get(META_CACHE, "data", null) != null) {
    return get(META_CACHE, "data", null);
  }
  let db = db_scan();
  let ad = db_asset();
  let d = sql_query(db, "select max(date) as latest, count(distinct code) as stocks, count(*) as rows from stock_analysis");
  let latest = null;
  let stocks = 0;
  let arows = 0;
  if (len(d) > 0) {
    latest = get(d[0], "latest");
    stocks = int(get(d[0], "stocks", 0));
    arows = int(get(d[0], "rows", 0));
  }
  let a = sql_query(ad, "select count(*) as n from asset_snapshot");
  let n = 0;
  if (len(a) > 0) { n = int(get(a[0], "n", 0)); }
  let payload = { ok: true, latest_date: latest, stocks: stocks, analysis_rows: arows, asset_rows: n };
  put(META_CACHE, "exp", now() + 300);
  put(META_CACHE, "data", payload);
  return payload;
}

// ---- 全市场信号扫描: 最近一个交易日, 遍历 ETL 已算好的 flag 列分类 ----
// 口径与 stock-analyzer src/etl/pipeline.py 一致: macd_cross/kdj_cross=金叉,
// rsi_oversold/overbought(30/70), williams(±80/-20), obv_signal, boll_position(>1 破上轨/<0 破下轨)。
// limit/min_sig: 返回「共振度(sig_cnt)最高」的前 limit 只; min_sig=最少同时命中几个信号。
// 注: ≥1 信号的全市场有 4000+ 只(83%, 无信息量), 价值在共振 ≥2/≥3/…, 故按 sig_cnt 降序,
// 且 SQL 侧 limit(ROW_CAP=200 内)保证 picks/signals 拿到的是「最强的 N 只」而非随机 N 只。
export func signals_payload(limit, min_sig) {
  let db = db_scan();
  let dates = sql_query(db, "select distinct date from stock_analysis order by date desc limit 2");
  if (len(dates) < 1) {
    return { ok: true, date: null, count: 0, total: 0, sig_counts: {}, dist: {}, signals: [], note: "暂无数据" };
  }
  let minn = int(min_sig);
  if (minn < 1) { minn = 1; }
  let last = get(dates[0], "date");
  // 9 条 ETL 规则的共振度(一行命中几个信号, 0-9)
  let sn = "(macd_cross=1)+(kdj_cross=1)+(rsi_oversold=1)+(rsi_overbought=1)+" +
           "(williams_oversold=1)+(williams_overbought=1)+(obv_signal=1)+" +
           "(boll_position>1.0)+(boll_position<0.0)";
  let rows = sql_query(db,
    "select code, close, change_percent, rsi, rsi_oversold, rsi_overbought, " +
    "macd_cross, kdj_cross, williams_oversold, williams_overbought, obv_signal, boll_position, " +
    sn + " as sig_cnt " +
    "from stock_analysis where date = ? and " + sn + " >= " + str(minn) + " " +
    "order by sig_cnt desc, obv_signal desc, close desc limit ?",
    [last, int(limit)]);
  // 全市场去重股票数 + 各类别命中数 + 共振分布: 单条 SQL 条件聚合(返回 1 行, 不受 ROW_CAP 截断;
  // 直接数循环行会因 ROW_CAP=200 只能看到 200 行, 得出 170 这种假总数)。
  // total = sum(SN>=1) = 「至少命中 1 个信号的去重股票数」(表头「N 只」用的就是它; 注意不是 sum(SN)=事件总数)。
  let sig_counts = {};
  let dist = {};
  let total = 0;
  let tc = sql_query(db,
    "select " +
    "sum(macd_cross=1) as c_macd, sum(kdj_cross=1) as c_kdj, " +
    "sum(rsi_oversold=1) as c_ros, sum(rsi_overbought=1) as c_ron, " +
    "sum(williams_oversold=1) as c_wos, sum(williams_overbought=1) as c_won, " +
    "sum(obv_signal=1) as c_obv, sum(boll_position>1.0) as c_bup, sum(boll_position<0.0) as c_bdn, " +
    "sum(" + sn + ">=1) as c_total, " +
    "sum(" + sn + ">=2) as g2, sum(" + sn + ">=3) as g3, " +
    "sum(" + sn + ">=4) as g4, sum(" + sn + ">=5) as g5 " +
    "from stock_analysis where date = ?", [last]);
  if (len(tc) > 0) {
    let x = tc[0];
    total = int(get(x, "c_total", 0));
    put(sig_counts, "MACD金叉", int(get(x, "c_macd", 0)));
    put(sig_counts, "KDJ金叉", int(get(x, "c_kdj", 0)));
    put(sig_counts, "RSI超卖", int(get(x, "c_ros", 0)));
    put(sig_counts, "RSI超买", int(get(x, "c_ron", 0)));
    put(sig_counts, "威廉超卖", int(get(x, "c_wos", 0)));
    put(sig_counts, "威廉超买", int(get(x, "c_won", 0)));
    put(sig_counts, "OBV放量", int(get(x, "c_obv", 0)));
    put(sig_counts, "突破布林上轨", int(get(x, "c_bup", 0)));
    put(sig_counts, "跌破布林下轨", int(get(x, "c_bdn", 0)));
    put(dist, "g2", int(get(x, "g2", 0)));
    put(dist, "g3", int(get(x, "g3", 0)));
    put(dist, "g4", int(get(x, "g4", 0)));
    put(dist, "g5", int(get(x, "g5", 0)));
  }
  let out = [];
  let i = 0;
  while (i < len(rows) and len(out) < limit) {
    let r = rows[i];
    let sigs = [];
    if (int(get(r, "macd_cross", 0)) == 1) { push(sigs, "MACD金叉"); }
    if (int(get(r, "kdj_cross", 0)) == 1) { push(sigs, "KDJ金叉"); }
    if (int(get(r, "rsi_oversold", 0)) == 1) { push(sigs, "RSI超卖"); }
    if (int(get(r, "rsi_overbought", 0)) == 1) { push(sigs, "RSI超买"); }
    if (int(get(r, "williams_oversold", 0)) == 1) { push(sigs, "威廉超卖"); }
    if (int(get(r, "williams_overbought", 0)) == 1) { push(sigs, "威廉超买"); }
    if (int(get(r, "obv_signal", 0)) == 1) { push(sigs, "OBV放量"); }
    let bp = float(get(r, "boll_position", 0.0));
    if (bp > 1.0) { push(sigs, "突破布林上轨"); }
    if (bp < 0.0) { push(sigs, "跌破布林下轨"); }
    if (len(sigs) > 0) {
      let rsi_etl = float(get(r, "rsi", 0.0));
      // 同口径复算: Lume rsi_cutler(Cutler, 与 ETL 同算法) → 按构造 Δ≈0,
      // 作为「Lume 内建移植正确性」的逐位验证列(实测全量库 80/80 match)。
      let rsi_lume = lume_rsi_cutler_live(get(r, "code"), 14);
      // 跨口径参考: Lume rsi(Wilder EMA) vs ETL(Cutler 滚动均值), 分叉量仅展示, 不作判定。
      let rsi_wilder = lume_rsi_live(get(r, "code"), 14);
      let tag = "none";
      if (rsi_lume != null) {
        let diff = rsi_lume - rsi_etl;
        if (diff < 0.0) { diff = -diff; }
        tag = diff < 0.05 ? "match" : "diff";
      }
      push(out, {
        code: get(r, "code"),
        close: float(get(r, "close", 0.0)),
        change: float(get(r, "change_percent", 0.0)),
        rsi: rsi_etl,
        rsi_lume: rsi_lume,
        rsi_wilder: rsi_wilder,
        rsi_match: tag,
        sig_cnt: int(get(r, "sig_cnt", len(sigs))),
        signals: sigs,
      });
    }
    i = i + 1;
  }
  // 给命中的标的补名称(asset_snapshot 按数字代码 IN 批量查一次; 未命中的走原路径不受影响)
  let codes = [];
  let k = 0;
  while (k < len(out)) { push(codes, get(out[k], "code")); k = k + 1; }
  let names = names_map(codes);
  k = 0;
  while (k < len(out)) {
    put(out[k], "name", get(names, numeric_of(get(out[k], "code", "")), ""));
    k = k + 1;
  }
  return { ok: true, date: last, count: len(out), total: total, sig_counts: sig_counts, dist: dist, min_sig: minn, signals: out };
}

// ============================================================================
// 信号质量统计 + 今日精选 — 「个人投资价值」核心: 把 70+ 条规则从「信仰」
// 变「证据」。历史战绩(180 天窗口函数, 单扫描条件聚合) + 大盘基准对照,
// 让每条当日信号挂上「该信号历史 5 日胜率/平均收益」。
// ============================================================================

// 按统计行的「信号列前缀」取列组装信号历史行(SQL 动态列名 → 逐 get, 缺列不硬填)
func sig_rec(x, sig, pre) {
  let rec = { sig: sig, n: int(get(x, pre + "_n", 0)) };
  let r1 = get(x, pre + "_r1", null);
  if (r1 != null) { put(rec, "r1", r1); }
  let r5 = get(x, pre + "_r5", null);
  if (r5 != null) { put(rec, "r5", r5); }
  let r10 = get(x, pre + "_r10", null);
  if (r10 != null) { put(rec, "r10", r10); }
  let w = get(x, pre + "_win", null);
  if (w != null) { put(rec, "win5", w); }
  return rec;
}

// xs 是否含 v(选择排序用的标记集; Lume list 不支持下标写, 排序只能重建)
func in_list(xs, v) {
  let i = 0;
  while (i < len(xs)) {
    if (xs[i] == v) { return true; }
    i = i + 1;
  }
  return false;
}

// ---- 信号历史战绩(180 天; lead() 窗口函数算 1/5/10 日后续收益)----
// 一条 SQL 扫 8.5M 行 ~7.8s, 结果 30min 模块级缓存(数据 18:30 才变)。
let STAT_CACHE = { exp: 0, data: null };

export func signal_stats_payload() {
  if (int(get(STAT_CACHE, "exp", 0)) >= now() and get(STAT_CACHE, "data", null) != null) {
    return get(STAT_CACHE, "data", null);
  }
  let db = db_scan();
  let q =
    "select " +
    "count(case when macd_cross=1 then 1 end) macd_n, " +
    "avg(case when macd_cross=1 and c1 is not null then (c1-close)/close*100.0 end) macd_r1, " +
    "avg(case when macd_cross=1 and c5 is not null then (c5-close)/close*100.0 end) macd_r5, " +
    "avg(case when macd_cross=1 and c10 is not null then (c10-close)/close*100.0 end) macd_r10, " +
    "100.0*sum(case when macd_cross=1 and c5>close then 1.0 else 0.0 end)/nullif(count(case when macd_cross=1 and c5 is not null then 1 end),0) macd_win, " +
    "count(case when kdj_cross=1 then 1 end) kdj_n, " +
    "avg(case when kdj_cross=1 and c1 is not null then (c1-close)/close*100.0 end) kdj_r1, " +
    "avg(case when kdj_cross=1 and c5 is not null then (c5-close)/close*100.0 end) kdj_r5, " +
    "avg(case when kdj_cross=1 and c10 is not null then (c10-close)/close*100.0 end) kdj_r10, " +
    "100.0*sum(case when kdj_cross=1 and c5>close then 1.0 else 0.0 end)/nullif(count(case when kdj_cross=1 and c5 is not null then 1 end),0) kdj_win, " +
    "count(case when rsi_oversold=1 then 1 end) rsi_n, " +
    "avg(case when rsi_oversold=1 and c1 is not null then (c1-close)/close*100.0 end) rsi_r1, " +
    "avg(case when rsi_oversold=1 and c5 is not null then (c5-close)/close*100.0 end) rsi_r5, " +
    "avg(case when rsi_oversold=1 and c10 is not null then (c10-close)/close*100.0 end) rsi_r10, " +
    "100.0*sum(case when rsi_oversold=1 and c5>close then 1.0 else 0.0 end)/nullif(count(case when rsi_oversold=1 and c5 is not null then 1 end),0) rsi_win, " +
    "count(case when obv_signal=1 then 1 end) obv_n, " +
    "avg(case when obv_signal=1 and c1 is not null then (c1-close)/close*100.0 end) obv_r1, " +
    "avg(case when obv_signal=1 and c5 is not null then (c5-close)/close*100.0 end) obv_r5, " +
    "avg(case when obv_signal=1 and c10 is not null then (c10-close)/close*100.0 end) obv_r10, " +
    "100.0*sum(case when obv_signal=1 and c5>close then 1.0 else 0.0 end)/nullif(count(case when obv_signal=1 and c5 is not null then 1 end),0) obv_win, " +
    "count(case when boll_position>1 then 1 end) boll_n, " +
    "avg(case when boll_position>1 and c5 is not null then (c5-close)/close*100.0 end) boll_r5, " +
    "100.0*sum(case when boll_position>1 and c5>close then 1.0 else 0.0 end)/nullif(count(case when boll_position>1 and c5 is not null then 1 end),0) boll_win, " +
    "count(case when williams_oversold=1 then 1 end) wil_n, " +
    "avg(case when williams_oversold=1 and c5 is not null then (c5-close)/close*100.0 end) wil_r5, " +
    "100.0*sum(case when williams_oversold=1 and c5>close then 1.0 else 0.0 end)/nullif(count(case when williams_oversold=1 and c5 is not null then 1 end),0) wil_win " +
    "from (" +
    "  select close, " +
    "    lead(close,1)  over (partition by code order by date) c1, " +
    "    lead(close,5)  over (partition by code order by date) c5, " +
    "    lead(close,10) over (partition by code order by date) c10, " +
    "    macd_cross, kdj_cross, rsi_oversold, obv_signal, williams_oversold, boll_position " +
    "  from stock_analysis " +
    "  where date >= date((select max(date) from stock_analysis), '-180 day') " +
    ")";
  let rows = sql_query(db, q, []);
  if (len(rows) < 1) {
    return { ok: false, reason: "信号统计查询失败", signals: [] };
  }
  let x = rows[0];
  let sigs = [];
  push(sigs, sig_rec(x, "MACD金叉", "macd"));
  push(sigs, sig_rec(x, "KDJ金叉", "kdj"));
  push(sigs, sig_rec(x, "RSI超卖", "rsi"));
  push(sigs, sig_rec(x, "OBV放量", "obv"));
  push(sigs, sig_rec(x, "突破布林上轨", "boll"));
  push(sigs, sig_rec(x, "威廉超卖", "wil"));
  put(STAT_CACHE, "exp", now() + 1800);
  put(STAT_CACHE, "data", {
    ok: true,
    window: "180d",
    ts: now(),
    signals: sigs,
    note: "胜率/平均收益 = 该信号历史 1/5/10 交易日后的价格变化(含全部事件, 未按个股去重); 仅描述历史, 不构成对未来有效的承诺",
  });
  return get(STAT_CACHE, "data", null);
}

// ---- 今日精选: 当日带信号票 × 量比 × 市值 综合打分, Top 8(10min 缓存)----
let PICKS_CACHE = { exp: 0, data: null };

export func picks_payload() {
  if (int(get(PICKS_CACHE, "exp", 0)) >= now() and get(PICKS_CACHE, "data", null) != null) {
    return get(PICKS_CACHE, "data", null);
  }
  let sig = signals_payload(999, 1);
  let picks = get(sig, "signals", []);
  let out = { ok: true, date: get(sig, "date", null), picks: [], note: "当日无信号, 无精选" };
  if (len(picks) > 0) {
    // 批量补名称+量比+市值(asset_snapshot)
    let db = db_asset();
    let codes = [];
    let i = 0;
    while (i < len(picks)) {
      let c = str(get(picks[i], "code", ""));
      if (len(c) == 8) { push(codes, substr(c, 2)); }
      i = i + 1;
    }
    let met = sql_query(db,
      "select code, volume_ratio, total_market_value from asset_snapshot where code in ('" +
      join(codes, "', '") + "')", []);
    let metmap = {};
    i = 0;
    while (i < len(met)) {
      put(metmap, str(get(met[i], "code", "")), met[i]);
      i = i + 1;
    }
    // 打分: 信号数*200 + 量比*30(上限 3.0) + 市值 100-1000 亿*50
    let ranked = [];
    i = 0;
    while (i < len(picks)) {
      let c = str(get(picks[i], "code", ""));
      let m = get(metmap, numeric_of(c), null);
      let vr = m != null ? float(get(m, "volume_ratio", 0.0)) : 0.0;
      let mv = m != null ? float(get(m, "total_market_value", 0.0)) : 0.0;
      let score = len(get(picks[i], "signals", [])) * 200.0
        + min(vr, 3.0) * 30.0
        + (mv >= 100.0 and mv <= 1000.0 ? 50.0 : 0.0);
      push(ranked, {
        code: c,
        name: get(picks[i], "name", ""),
        close: get(picks[i], "close"),
        change: get(picks[i], "change"),
        signals: get(picks[i], "signals", []),
        volume_ratio: vr > 0.0 ? vr : null,
        market_value: mv > 0.0 ? mv : null,
        score: score,
      });
      i = i + 1;
    }
    // 选择法取 Top 8: Lume 不支持 list 下标写(冒泡交换行不通), 每轮挑未选最大分
    let used = [];
    let picked = 0;
    while (picked < 8 and picked < len(ranked)) {
      let best = -1;
      let bestscore = -1.0;
      let q = 0;
      while (q < len(ranked)) {
        if (!in_list(used, q)) {
          let s = float(get(ranked[q], "score", 0.0));
          if (s > bestscore) { best = q; bestscore = s; }
        }
        q = q + 1;
      }
      if (best < 0) { break; }
      push(out.picks, ranked[best]);
      push(used, best);
      picked = picked + 1;
    }
    out.note = "按「信号数×量比×市值」打分取 Top 8(信号=当日 ETL flag, 量比/市值=asset_snapshot 快照); 非收益预测";
  }
  put(PICKS_CACHE, "exp", now() + 600);
  put(PICKS_CACHE, "data", out);
  return out;
}

// ---- 规则筛选: POST filters map → 白名单字段 WHERE(列名固定, 值走 ? 占位, 杜绝注入) ----
// 在 asset_snapshot(估值/量能字段, 含名称)上做; 未传 filters 返回量比前 limit 名。
export func screen_payload(filters, limit) {
  let db = db_asset();
  let where = "1=1";
  let params = [];
  if (filters != null) {
    let vr = get(filters, "volume_ratio_min");
    if (vr != null) { where = where + " and volume_ratio >= ?"; push(params, float(vr)); }
    let to = get(filters, "turnover_rate_min");
    if (to != null) { where = where + " and turnover_rate >= ?"; push(params, float(to)); }
    let mv = get(filters, "total_market_value_min");
    if (mv != null) { where = where + " and total_market_value >= ?"; push(params, float(mv)); }
    let cl = get(filters, "close_min");
    if (cl != null) { where = where + " and close >= ?"; push(params, float(cl)); }
    let ch = get(filters, "close_max");
    if (ch != null) { where = where + " and close <= ?"; push(params, float(ch)); }
  }
  let sql = "select code, name, close, change_percent, volume_ratio, turnover_rate, total_market_value, float_market_value " +
            "from asset_snapshot where " + where + " order by volume_ratio desc limit ?";
  push(params, int(limit));
  let rows = sql_query(db, sql, params);
  return { ok: true, count: len(rows), rows: rows, where: where };
}

// ---- 代码归一: asset_snapshot 用纯 6 位数字, stock_analysis 带 sh/sz/bj 前缀 ----
// 6 位数字 → 按板块补前缀(6/9=沪, 0/2/3=深, 4/8=北); 已带前缀的原样返回。
export func norm_code(c) {
  let s = str(c);
  if (len(s) == 8) {
    let p = lower(substr(s, 0, 2));
    if (p == "sh" or p == "sz" or p == "bj") { return s; }
  }
  if (len(s) == 6) {
    let d = substr(s, 0, 1);
    if (d == "6" or d == "9") { return "sh" + s; }
    if (d == "0" or d == "2" or d == "3") { return "sz" + s; }
    return "bj" + s;
  }
  return s;
}

// ---- 个股 K 线 + 指标序列(近 days 日, 时间升序; 入参可带或不带市场前缀)----
export func stock_payload(code, days) {
  let db = db_scan();
  let c = norm_code(code);
  let rows = sql_query(db,
    "select date, open, high, low, close, volume, change_percent, ma5, ma20, rsi, macd, macd_signal, kdj_k, kdj_d, atr " +
    "from stock_analysis where code = ? order by date desc limit ?", [c, int(days)]);
  let asc = [];
  let i = len(rows) - 1;
  while (i >= 0) { push(asc, rows[i]); i = i - 1; }
  let names = names_map([c]);
  return {
    ok: true, code: c,
    name: get(names, numeric_of(c), ""),
    days: len(asc), series: asc,
  };
}

// ---- 二期(#54): 实时技术指标 — 只读原始 OHLCV, 用 Lume 内建现算, 不依赖 Python ETL 列 ----
// 把 sql 结果某数值列抽成 Lume float list(供指标内建消费; 行已按日期升序)。
func col_of(rows, key) {
  let out = [];
  let i = 0;
  while (i < len(rows)) {
    push(out, float(get(rows[i], key, 0.0)));
    i = i + 1;
  }
  return out;
}

// 字符串列(如 date)原样抽成 list(不做数值宽化)。
func str_col_of(rows, key) {
  let out = [];
  let i = 0;
  while (i < len(rows)) {
    push(out, str(get(rows[i], key, "")));
    i = i + 1;
  }
  return out;
}

// 指标序列前 window-1 项是 NAN(冷启动), 截到首个有效值起, 且把 NAN 归一为 null,
// 保证 JSON 响应合法(前导冷启动不留 NaN, 前端直接渲染)。
func clean_list(xs, from) {
  let out = [];
  let i = from;
  while (i < len(xs)) {
    let v = xs[i];
    let is_nan = (v != v);
    push(out, is_nan ? null : v);
    i = i + 1;
  }
  return out;
}

// 尾部 k 个值(null 保留)
func tail_k(xs, k) {
  let out = [];
  let i = len(xs) - k;
  while (i < len(xs)) { push(out, xs[i]); i = i + 1; }
  return out;
}

// RSI 现算结果模块级缓存: 信号页每次进页 80 行 × 两口径 = 160 次独立 SQL(虽走
// idx_analysis_code_date 索引, 但重复跑无意义)。库内数据日更, 60s TTL 足够。
let RSI_CACHE = {};   // "code:period" → { exp: int, v: number | null }

// Lume 现算 Wilder RSI(读最近 ~64 根收盘价, 不读 ETL rsi 列), 返回尾值(1 位小数)或 null。
// 用于信号页 ETL(Cutler) vs Lume(Wilder) 双口径对照: 同一只票, 两种 RSI 平滑方式的分叉量。
export func lume_rsi_live(code, period) {
  let c = norm_code(code);
  let w = int(period);
  let ck = c + ":" + str(w);
  let hit = get(RSI_CACHE, ck, null);
  if (hit != null and int(get(hit, "exp", 0)) >= now()) {
    return get(hit, "v", null);
  }
  let db = db_scan();
  let rows = sql_query(db,
    "select close from stock_analysis where code = ? order by date desc limit 64",
    [c]);
  let v = null;
  if (len(rows) >= 3) {
    let asc = [];
    let i = len(rows) - 1;
    while (i >= 0) { push(asc, rows[i]); i = i - 1; }
    let closes = col_of(asc, "close");
    let ww = w;
    if (ww > len(closes) - 1) { ww = len(closes) - 1; }
    if (ww >= 1) {
      let rs = rsi(closes, ww);
      let last = tail_k(rs, 1)[0];
      if (last != null and last == last) { v = last; }
    }
  }
  put(RSI_CACHE, ck, { exp: now() + 60, v: v });
  return v;
}

// Lume 现算 Cutler RSI 尾值(与 ETL _calculate_rsi 同口径, 精确复现: 涨/跌各取最近
// w 个价变的 rolling 均值)。Cutler 是「本地窗口」—— 尾值只依赖最近 w+1 根收盘价,
// 无 Wilder 的 EMA 种子 warm-up, 故与 ETL 全历史列值按构造 Δ≈0(实测 6/6 逐位一致)。
// 只需读 period+1 根(而非 64), 比 Wilder 路径更省; 结果带 60s 模块级缓存。
export func lume_rsi_cutler_live(code, period) {
  let c = norm_code(code);
  let w = int(period);
  let ck = "cutler:" + c + ":" + str(w);
  let hit = get(RSI_CACHE, ck, null);
  if (hit != null and int(get(hit, "exp", 0)) >= now()) {
    return get(hit, "v", null);
  }
  let db = db_scan();
  let need = w + 2;
  let rows = sql_query(db,
    "select close from stock_analysis where code = ? order by date desc limit ?",
    [c, need]);
  let v = null;
  if (len(rows) >= w + 1) {
    let asc = [];
    let i = len(rows) - 1;
    while (i >= 0) { push(asc, rows[i]); i = i - 1; }
    let closes = col_of(asc, "close");
    let ww = w;
    if (ww > len(closes) - 1) { ww = len(closes) - 1; }
    if (ww >= 1) {
      let out = rsi_cutler(closes, ww);
      let last = tail_k(out, 1)[0];
      if (last != null and last == last) { v = last; }
    }
  }
  put(RSI_CACHE, ck, { exp: now() + 60, v: v });
  return v;
}

// ============================================================================
// 实时行情层 — 腾讯 qt.gtimg.cn(免费免 token 文本源; 容器实测稳定 0.08s)。
// 为何不用东财 JSON: OrbStack NAT 挡 push2.eastmoney.com(http/https 均 000),
// 而腾讯 qt.gtimg.cn 容器内 Lume http_get 直连 200。
// 单票:   q=<sh|sz|bj>+6位 全字段(88), 中文名称为 GBK 字节 → 名称改从本地
//         asset 库 names_map(UTF-8) 取, 只取数值字段(ASCII 安全)。
// 指数:   q=s_sh000001,s_sz399001,s_sz399006,s_sh000300 短报价(一记录 6 字段)。
// 边界(已探明): http_get 失败不抛错(ok=false+err); 缓存 miss 时前端拿
// ok=false+reason 降级显示库内收盘。模块级 TTL 缓存: 单票 15s / 指数 30s。
// ============================================================================

let RT_CACHE = {};   // code → { exp: int, data: map }

// 数值字段: "-" / "" / 缺 → null(停牌或缺数据), 否则 float
func rt_num(v) {
  let s = str(v);
  if (s == "" or s == "-" or s == "null") { return null; }
  return float(s);
}

// ---- 单票实时行情(15s 缓存); 前端个股页 5s 轮询 ----
export func realtime_payload(code) {
  let c = norm_code(code);
  let hit = get(RT_CACHE, c, null);
  if (hit != null and int(get(hit, "exp", 0)) >= now()) {
    return get(hit, "data", hit);
  }
  let r = http_get("http://qt.gtimg.cn/q=" + c, { timeout: 5.0 });
  let body = str(get(r, "body", ""));
  if (!get(r, "ok", false) or len(body) < 20) {
    return { ok: false, code: c, reason: "实时获取失败: " + str(substr(str(get(r, "err", "")), 0, 40)) };
  }
  // body: v_sh600519="1~名~600519~现价~昨收~今开~...~涨跌~涨跌%~高~低~...";
  let parts = split(body, "\"");
  let f = split(get(parts, 1, ""), "~");
  if (len(f) < 40) {
    return { ok: false, code: c, reason: "实时源返回异常" };
  }
  let price = rt_num(f[3]);
  if (price == null) {
    return { ok: true, code: c, suspended: true, reason: "停牌或无行情" };
  }
  let names = names_map([c]);
  let nm = get(names, numeric_of(c), "");
  let rec = {
    ok: true, code: c,
    name: nm,
    price: price,
    prev_close: rt_num(f[4]),
    open: rt_num(f[5]),
    high: rt_num(f[33]),
    low: rt_num(f[34]),
    change: rt_num(f[31]),
    change_pct: rt_num(f[32]),
    volume: rt_num(f[36]),        // 手
    amount: rt_num(f[37]),        // 万元
    quote_time: str(f[30]),      // yyyymmddHHMMSS
    ts: now(),
  };
  put(RT_CACHE, c, { exp: now() + 15, data: rec });
  return rec;
}

// ---- 批量实时行情: 1 个 http_get 拉 N 只(腾讯 q=a,b,c 逗号拼接) ----
// 替代逐票串行(N 次请求), paper_payload 12 只持仓 0.9s → ~80ms。
// 响应: v_sh601811="1~名~601811~现价~...";v_sz002811="2~..."; 以 ; 分隔多条全量报价,
// 字段下标与单票 realtime_payload 完全一致(f[3]=现价/f[4]=昨收/f[31]=涨跌/f[32]=涨跌%/...)。
export func realtime_batch(codes) {
  let out = {};
  if (len(codes) == 0) { return { ok: true, quotes: out, ts: now() }; }
  let qs = [];
  let qi = 0;
  while (qi < len(codes)) {
    let q = norm_code(str(codes[qi]));
    if (!in_list(qs, q)) { push(qs, q); }
    qi = qi + 1;
  }
  let url = "http://qt.gtimg.cn/q=" + join(qs, ",");
  let r = http_get(url, { timeout: 6.0 });
  let body = str(get(r, "body", ""));
  if (!get(r, "ok", false) or len(body) < 20) {
    return { ok: false, reason: "批量实时获取失败: " + str(substr(str(get(r, "err", "")), 0, 40)), quotes: out };
  }
  let recs = split(body, ";");
  let j = 0;
  while (j < len(recs)) {
    let rec = trim(str(recs[j]));
    if (contains(rec, "v_") and contains(rec, "\"")) {
      let parts = split(rec, "\"");
      let q0 = trim(str(get(parts, 0, "")));
      let code = substr(str(split(q0, "=")[0]), 2);   // "v_sh601811=" → "sh601811"
      let data = split(str(get(parts, 1, "")), "~");
      let qm = {
        price: rt_num(get(data, 3, "")),
        prev_close: rt_num(get(data, 4, "")),
        open: rt_num(get(data, 5, "")),
        high: rt_num(get(data, 33, "")),
        low: rt_num(get(data, 34, "")),
        change: rt_num(get(data, 31, "")),
        change_pct: rt_num(get(data, 32, "")),
        volume: rt_num(get(data, 36, "")),
        amount: rt_num(get(data, 37, "")),
        quote_time: str(get(data, 30, "")),
      };
      put(out, code, qm);
    }
    j = j + 1;
  }
  return { ok: true, quotes: out, ts: now() };
}

// ---- 四大指数(30s 缓存); 信号页指数条 30s 轮询 ----
// 短报价 s_ 记录: ~分隔 [1]=名称(GBK 弃用), [2]=代码, [3]=点位, [4]=涨跌, [5]=涨跌%
let IDX_URL = "http://qt.gtimg.cn/q=s_sh000001,s_sz399001,s_sz399006,s_sh000300";
let IDX_NAMES = { "000001": "上证指数", "399001": "深证成指", "399006": "创业板指", "000300": "沪深300" };
let IDX_CACHE = { exp: 0, data: [], fetched: 0 };

export func indexes_payload() {
  if (int(get(IDX_CACHE, "exp", 0)) >= now() and len(get(IDX_CACHE, "data", [])) > 0) {
    return { ok: true, ts: get(IDX_CACHE, "fetched", 0), indexes: get(IDX_CACHE, "data", []) };
  }
  let r = http_get(IDX_URL, { timeout: 5.0 });
  let body = str(get(r, "body", ""));
  if (!get(r, "ok", false) or len(body) < 20) {
    return { ok: false, reason: "指数获取失败", indexes: get(IDX_CACHE, "data", []), ts: get(IDX_CACHE, "fetched", 0) };
  }
  // 每记录 v_s_xxx="..."; → 按 " 切分, 奇数位是记录内容
  let segs = split(body, "\"");
  let out = [];
  let i = 1;
  while (i + 1 < len(segs)) {
    let f = split(segs[i], "~");
    if (len(f) > 5) {
      let code = str(f[2]);
      push(out, {
        code: code,
        name: get(IDX_NAMES, code, code),
        price: rt_num(f[3]),
        change: rt_num(f[4]),
        change_pct: rt_num(f[5]),
      });
    }
    i = i + 2;
  }
  if (len(out) > 0) {
    put(IDX_CACHE, "exp", now() + 30);
    put(IDX_CACHE, "data", out);
    put(IDX_CACHE, "fetched", now());
  }
  return { ok: true, ts: now(), indexes: out };
}

export func indicators_payload(code, days, period) {
  let db = db_scan();
  let c = norm_code(code);
  let p = int(period);
  if (p < 2) { p = 14; }
  if (days < 2) { days = 2; }
  let rows = sql_query(db,
    "select date, high, low, close, volume from stock_analysis where code = ? order by date desc limit ?",
    [c, int(days)]);
  let asc = [];
  let i = len(rows) - 1;
  while (i >= 0) { push(asc, rows[i]); i = i - 1; }
  let n = len(asc);
  let dates = str_col_of(asc, "date");
  let names = names_map([c]);
  let nm = get(names, numeric_of(c), "");
  let highs = col_of(asc, "high");
  let lows = col_of(asc, "low");
  let closes = col_of(asc, "close");
  let vols = col_of(asc, "volume");
  // 不足 3 根 K 线: RSI14/BOLL20 及绩效(需 >=2 个日收益)都算不出, 直接给 sparse 响应不抛错。
  // 旧 bug: 样例库每股仅 5 根 K 线 × 硬编码 rsi(closes,14)/bollinger(closes,20) 越界 →
  // 内建抛错 → 500 HTML(<!DOCTYPE) → 前端 r.json() 报 "Unexpected token '<'".
  if (n < 3) {
    return { ok: true, code: c, name: nm, days: n, period: p, dates: dates,
            note: "K 线不足 3 根, 指标与绩效暂缺",
            kdj: null, williams_r: null, atr: null, obv: null,
            closes: closes, ma5: null, ma10: null, ma20: null,
            macd: null, rsi_wilder: null, rsi_cutler: null, boll: null,
            performance: null, lume_signals: [] };
  }
  let cut = p - 1;
  // ---- #54 摆动类 ----
  let kd = kdj(highs, lows, closes, p);
  // ---- #55 趋势类(同为 Lume 内建现算, 不读 ETL 列)----
  // 窗口自适应: rsi 需 window∈[1, n-1], bollinger 需 window∈[2, n], 短 K 线(3..19 根)
  // 收缩到有效范围, 避免内建抛错; n>=20 时保持标准 14/20。
  let rsi_win = 14;
  if (rsi_win > n - 1) { rsi_win = n - 1; }
  let bb_win = 20;
  if (bb_win > n) { bb_win = n; }
  let ma5 = clean_list(rolling_mean(closes, 5), 4);
  let ma10 = clean_list(rolling_mean(closes, 10), 9);
  let ma20 = clean_list(rolling_mean(closes, 20), 19);
  let mc = macd(closes, 12, 26, 9);
  let macd_line = clean_list(get(mc, "macd", []), 0);
  let macd_sig = clean_list(get(mc, "signal", []), 0);
  let macd_hist = clean_list(get(mc, "hist", []), 0);
  let rsi_w = clean_list(rsi(closes, rsi_win), rsi_win - 1);
  let rsi_cut = clean_list(rsi_cutler(closes, rsi_win), rsi_win - 1);
  let bb = bollinger(closes, bb_win, 2.0);
  let bb_mid = clean_list(get(bb, "mid", []), bb_win - 1);
  let bb_up = clean_list(get(bb, "upper", []), bb_win - 1);
  let bb_lo = clean_list(get(bb, "lower", []), bb_win - 1);
  // ---- #55 绩效面板(n>=3 ⇒ 日收益 >=2, 各内建可算; 年化系数 = core sqrt(252))----
  // core 的 sharpe/annualized_vol/var/cvar 期望"小数"日收益(0.01=1%), pct_change
  // 输出百分数(100x), 故 /100 归一后再喂; calmar/年化收益直接吃价格序列, 不受影响。
  let rets100 = pct_change(closes);
  let rets = [];
  i = 0;
  while (i < len(rets100)) {
    let v = rets100[i];
    push(rets, v != v ? v : v / 100.0);
    i = i + 1;
  }
  let perf = {
    cumulative: cumulative_return(closes) * 100.0,
    annualized_return: annualized_return(closes) * 100.0,
    annualized_vol: annualized_volatility(rets) * 100.0,
    sharpe: sharpe_ratio(rets, 0.0),
    sortino: sortino_ratio(rets, 0.0),
    calmar: calmar_ratio(closes),
    max_drawdown_pct: max_drawdown(closes),
    var_95: value_at_risk(rets, 0.05) * 100.0,
    cvar_95: expected_shortfall(rets, 0.05) * 100.0,
    // #57 分布形态: 日收益偏度/峰度(超额, 正态=0). skew 需 >=3 个收益, kurtosis 需 >=4, 不足则省略.
  };
  if (len(rets) >= 3) { put(perf, "skew", skew(rets)); }
  if (len(rets) >= 4) { put(perf, "kurtosis", kurtosis(rets)); }
  // ---- #55 Lume 侧信号判定(基于刚算出的序列尾值, 不读 ETL flag 列)----
  let sigs = [];
  let last_macd = tail_k(macd_line, 1)[0];
  let last_sig = tail_k(macd_sig, 1)[0];
  let l2_macd = tail_k(macd_line, 2)[0];
  let l2_sig = tail_k(macd_sig, 2)[0];
  if (l2_macd != null and l2_sig != null and last_macd != null and last_sig != null) {
    if (l2_macd <= l2_sig and last_macd > last_sig) {
      push(sigs, "MACD金叉(Lume)");
    } else if (l2_macd >= l2_sig and last_macd < last_sig) {
      push(sigs, "MACD死叉(Lume)");
    }
  }
  let last_rsi = tail_k(rsi_w, 1)[0];
  if (last_rsi != null and last_rsi < 30.0) { push(sigs, "RSI超卖(Wilder 14)"); }
  if (last_rsi != null and last_rsi > 70.0) { push(sigs, "RSI超买(Wilder 14)"); }
  let last_close = tail_k(closes, 1)[0];
  let last_up = tail_k(bb_up, 1)[0];
  let last_lo = tail_k(bb_lo, 1)[0];
  if (last_up != null and last_close > last_up) { push(sigs, "破布林上轨(20,2)"); }
  if (last_lo != null and last_close < last_lo) { push(sigs, "破布林下轨(20,2)"); }
  let l3_k = tail_k(get(kd, "k", []), 3);
  let l3_d = tail_k(get(kd, "d", []), 3);
  if (len(l3_k) == 3 and len(l3_d) == 3 and l3_k[1] != null and l3_d[1] != null
      and l3_k[1] <= l3_d[1] and l3_k[2] > l3_d[2]) {
    push(sigs, "KDJ金叉");
  }
  return {
    ok: true, code: c, name: nm, days: n, period: p, dates: dates,
    kdj: {
      rsv: clean_list(get(kd, "rsv", []), cut),
      k: clean_list(get(kd, "k", []), cut),
      d: clean_list(get(kd, "d", []), cut),
      j: clean_list(get(kd, "j", []), cut),
    },
    closes: closes,
    williams_r: clean_list(williams_r(highs, lows, closes, p), cut),
    atr: clean_list(atr(highs, lows, closes, p), cut),
    obv: clean_list(obv(closes, vols), 0),
    ma5: ma5, ma10: ma10, ma20: ma20,
    macd: { line: macd_line, signal: macd_sig, hist: macd_hist },
    rsi_wilder: rsi_w,
    rsi_cutler: rsi_cut,
    boll: { mid: bb_mid, upper: bb_up, lower: bb_lo },
    performance: perf,
    lume_signals: sigs,
  };
}

// ============================================================================
// 模拟仓 (paper trading) — 读 stock-analyzer 的 paper_portfolio.json
// 宿主 ETL 每日 18:30 自动交易后落盘, 容器把整个 data/ 只读挂载进 /app/data。
// 本服务只读: 用现有实时行情通道(giveTencent, 15s 缓存)给每个持仓挂现价,
// 现算浮动盈亏/止损/止盈。PAPER_PORTFOLIO 经 env 注入(compose/Makefile);
// 缺省 .data/paper_portfolio.json, 读不到 → ok=false + 说明(前端降级显示)。
// 注意: Lume 局部变量不能从 null 重赋值到具体类型, 故 P&L 全部拆成
// 「一次返回」的 helper 函数, 不写 let x=null; x=... 的坏模式。
// ============================================================================
let PAPER_CACHE = { exp: 0, data: null };

func paper_cost(p) {
  return float(get(p, "buy_price", 0)) * float(get(p, "shares", 0));
}
func paper_upnl(p, price) {
  let buy = float(get(p, "buy_price", 0));
  let sh = float(get(p, "shares", 0));
  if (price == null or buy <= 0.0) { return null; }
  return price * sh - buy * sh;
}
func paper_upnl_pct(p, price) {
  let buy = float(get(p, "buy_price", 0));
  if (price == null or buy <= 0.0) { return null; }
  return (price - buy) / buy * 100.0;
}
func paper_stop_hit(p, price) {
  let sl = float(get(p, "stop_loss", 0));   // 0.08 = 跌 8% 触发止损
  let pct = paper_upnl_pct(p, price);
  if (pct == null or sl <= 0.0) { return null; }
  return pct <= -(sl * 100.0);
}
func paper_target_hit(p, price) {
  let tp = float(get(p, "take_profit", 0));  // 0.2 = 涨 20% 触发止盈
  let pct = paper_upnl_pct(p, price);
  if (pct == null or tp <= 0.0) { return null; }
  return pct >= tp * 100.0;
}

func paper_corr_matrix(codes, n) {
  let m = len(codes);
  let r = [];
  let i = 0;
  while (i < m) {
    let row = [];
    let j = 0;
    while (j < m) {
      let v = 1.0;
      if (i != j) {
        let a = paper_ret_series(codes[i], n);
        let b = paper_ret_series(codes[j], n);
        if (a != null and b != null) {
          // 尾部对齐到较短序列(最近交易日), 再算 Pearson 相关
          let la = len(a);
          let lb = len(b);
          let t = la;
          if (lb < la) { t = lb; }
          let sa = [];
          let sb = [];
          let k = 0;
          while (k < t) {
            push(sa, a[la - t + k]);
            push(sb, b[lb - t + k]);
            k = k + 1;
          }
          let cr = try(() => correlation(sa, sb));
          if (get(cr, "err", null) == null) { v = float(get(cr, "ok", 0)); } else { v = null; }
        } else { v = null; }
      }
      push(row, v);
      j = j + 1;
    }
    push(r, row);
    i = i + 1;
  }
  return r;
}
// Kelly 仓位建议: 对该持仓最近 60 日日收益算 f* = 均值/方差(凯利公式).
// 只对「有正期望」的持仓才有意义; 序列不可算/方差<=0 → null.
func paper_kelly(code, n) {
  let rets = paper_ret_series(code, n);
  if (rets == null) { return null; }
  let kr = try(() => kelly_fraction(rets));
  let v = get(kr, "ok", null);
  if (v == null or v != v) { return null; }
  // 负期望(均值<0)给不出正仓位, 视为 0
  if (v < 0.0) { return 0.0; }
  return v;
}
// 60 日日收益序列(持仓相关性用). close 不足 2 根返回 null.
func paper_ret_series(code, n) {
  let db = db_scan();
  let rows = sql_query(db,
    "select close from stock_analysis where code = ? order by date desc limit ?",
    [code, n + 1]);
  if (len(rows) < 2) { return null; }
  let asc = [];
  let i = len(rows) - 1;
  while (i >= 0) { push(asc, rows[i]); i = i - 1; }
  let closes = col_of(asc, "close");
  let rets100 = pct_change(closes);
  let out = [];
  i = 0;
  while (i < len(rets100)) {
    let v = rets100[i];
    if (v == v) { push(out, v); }
    i = i + 1;
  }
  if (len(out) < 2) { return null; }
  return out;
}

export func paper_payload() {
  if (int(get(PAPER_CACHE, "exp", 0)) >= now()) { return get(PAPER_CACHE, "data", PAPER_CACHE); }
  let path = env("PAPER_PORTFOLIO");
  if (path == null) { path = ".data/paper_portfolio.json"; }
  let raw = read_file(path);
  if (raw == null) {
    let msg = { ok: false, ts: now(), reason: "未找到模拟仓文件 (PAPER_PORTFOLIO=" + path + "); 容器需挂载 stock-analyzer data/, 或设 PAPER_PORTFOLIO 指向 paper_portfolio.json" };
    put(PAPER_CACHE, "exp", now() + 15);
    put(PAPER_CACHE, "data", msg);
    return msg;
  }
  let jp = try(() => json(raw));
  if (get(jp, "err", null) != null) {
    let msg = { ok: false, ts: now(), reason: "模拟仓 JSON 解析失败: " + str(get(jp, "err", "")) };
    put(PAPER_CACHE, "exp", now() + 30);
    put(PAPER_CACHE, "data", msg);
    return msg;
  }
  let d = get(jp, "ok");
  let cash = float(get(d, "cash", 0));
  let init = float(get(d, "initial_capital", 100000));
  let posmap = get(d, "positions", {});
  let ks = keys(posmap);
  // 批量取全部持仓现价: 1 个 http_get(腾讯 q=多票逗号拼接), 取代逐票 12 次串行。
  let quotes = get(realtime_batch(ks), "quotes", {});
  let positions = [];
  let mtm = 0.0;
  let i = 0;
  while (i < len(ks)) {
    let code = str(ks[i]);
    let p = get(posmap, code, {});
    let rt = get(quotes, code, null);
    let rt0 = (rt != null) ? rt : {};
    let price = get(rt0, "price", null);
    let row = {
      code: code,
      name: str(get(p, "name", "")),
      buy_date: str(get(p, "buy_date", "")),
      buy_price: float(get(p, "buy_price", 0)),
      shares: float(get(p, "shares", 0)),
      stop_loss: float(get(p, "stop_loss", 0)),
      take_profit: float(get(p, "take_profit", 0)),
      reason: str(get(p, "reason", "")),
      price: price,
      realtime_ok: get(rt0, "ok", (price != null)),
      suspended: get(rt0, "suspended", false),
      cost: paper_cost(p),
      upnl: paper_upnl(p, price),
      upnl_pct: paper_upnl_pct(p, price),
      stop_hit: paper_stop_hit(p, price),
      target_hit: paper_target_hit(p, price),
      kelly: paper_kelly(code, 60),
    };
    push(positions, row);
    if (price != null) { mtm = mtm + price * float(get(p, "shares", 0)); }
    i = i + 1;
  }
  let total = mtm + cash;
  // 挂单补名称: 复用 names_map(asset_snapshot), key = numeric_of(code)
  let pendraw = get(d, "pending", []);
  let pend_codes = [];
  let cj = 0;
  while (cj < len(pendraw)) {
    push(pend_codes, str(get(pendraw[cj], "code", "")));
    cj = cj + 1;
  }
  let pnames = names_map(pend_codes);
  let pn = [];
  let ni = 0;
  while (ni < len(pendraw)) {
    let o = pendraw[ni];
    let oc = str(get(o, "code", ""));
    let onew = {
      side: str(get(o, "side", "")),
      code: oc,
      name: get(pnames, numeric_of(oc), ""),
      signal_date: str(get(o, "signal_date", "")),
      reason: str(get(o, "reason", "")),
    };
    push(pn, onew);
    ni = ni + 1;
  }
  // #57 持仓两两相关性(60 日日收益 Pearson, correlation 内建; 常数序列 → null)
  let cm = paper_corr_matrix(ks, 60);
  let payload = {
    ok: true,
    ts: now(),
    updated_at: str(get(d, "updated_at", "")),
    initial_capital: init,
    cash: cash,
    equity: total,
    total_pnl: total - init,
    total_pnl_pct: (total - init) / init * 100.0,
    positions: positions,
    closed: int(len(get(d, "closed", []))),
    pending: pn,
    corr_window: 60,
    corr_matrix: cm,
  };
  put(PAPER_CACHE, "exp", now() + 30);
  put(PAPER_CACHE, "data", payload);
  return payload;
}

// ---- 数据新鲜度 (K线最新交易日 / 资产快照 updated_at / 模拟仓 updated_at) ----
// 目的: 前端一眼看到「哪些数据停了」, 像资产快照 8/23 停更 64 天那种问题第一天就暴露。
// 滞后天数由前端用本地时钟算, Lume 侧只返回原始时间戳。
export func freshness_payload() {
  let d = sql_query(db_scan(), "select max(date) as latest from stock_analysis");
  let latest = null;
  if (len(d) > 0) { latest = get(d[0], "latest"); }
  let a = sql_query(db_asset(), "select max(updated_at) as up, count(*) as n from asset_snapshot");
  let snap_up = null;
  let snap_n = 0;
  if (len(a) > 0) { snap_up = get(a[0], "up"); snap_n = int(get(a[0], "n", 0)); }
  let ppath = env("PAPER_PORTFOLIO");
  if (ppath == null) { ppath = ".data/paper_portfolio.json"; }
  let praw = read_file(ppath);
  let paper_up = null;
  if (praw != null) {
    let pj = try(() => json(praw));
    if (get(pj, "err", null) == null) { paper_up = str(get(get(pj, "ok"), "updated_at", "")); }
  }
  return {
    ok: true,
    ts: now(),
    analysis_latest: latest,
    snapshot_updated_at: snap_up,
    snapshot_rows: snap_n,
    paper_updated_at: paper_up,
  };
}

// ============================================================================
// agent 工具(顶层注册, 白名单由 make dev 注入 HARNESS_TOOLS_ALLOW 过滤)
// 全部只读: 只调 sql_query(SELECT-only 物理只读), 无任何写操作。
// ============================================================================
tool "scan_signals", "扫描全市场最新交易日的技术信号(MACD金叉/KDJ金叉/RSI超买卖/布林带突破/OBV放量), 按共振度(同时命中几个信号)降序返回。可选 arg.min_sig(默认1)控制最少命中几个信号, 越大越聚焦稀有共振。", {}, (arg) => {
  let ms = int(get(arg, "min_sig", "1"));
  return signals_payload(80, ms);
};

tool "screen_stocks", "按估值/量能规则筛选个股: filters 可含 volume_ratio_min / turnover_rate_min / total_market_value_min / close_min / close_max(单位亿元/次/元), 返回匹配标的(名称+量比+换手+市值)。", { filters: map }, (arg) => {
  return screen_payload(get(arg, "filters"), 50);
};

tool "stock_kline", "查个股近 N 日 K 线与技术指标序列(code 带 sh/sz/bj 市场前缀, days 缺省 60), 返回按时间升序的 open/high/low/close/ma5/ma20/rsi/macd 序列。", { code: string, days: int }, (arg) => {
  let d = arg.days;
  if (d <= 0) { d = 60; }
  return stock_payload(arg.code, d);
};

tool "stock_indicators", "实时重算个股 KDJ/Williams%R/ATR/OBV(读原始 high/low/close/volume, 用 Lume 内建现算, 不依赖 Python ETL 指标列)。code 带/不带市场前缀均可, days 缺省 60, period 缺省 14。返回截去冷启动后的序列。", { code: string, days: int, period: int }, (arg) => {
  let d = arg.days;
  if (d <= 0) { d = 60; }
  let p = arg.period;
  if (p <= 0) { p = 14; }
  return indicators_payload(arg.code, d, p);
};

// 实时行情工具(腾讯 qt.gtimg.cn; 服务端 15s/30s TTL 缓存, agent 轮询不打爆上游)。
// 与 stock_kline/stock_indicators(库内 T-1 数据)互补: 盘中问「现在多少」走这俩。
tool "realtime_quote", "查个股实时行情(现价/涨跌/开高低昨收/量额/时间戳, 腾讯源, 15s 缓存)。code 带/不带 sh/sz/bj 前缀均可。停牌或上游失败时 ok=false + reason。", { code: string }, (arg) => {
  return realtime_payload(arg.code);
};

tool "market_indexes", "查四大指数实时点位(上证指数/深证成指/创业板指/沪深300, 30s 缓存)。", {}, (arg) => {
  return indexes_payload();
};

tool "signal_stats", "查各技术信号近 180 天历史战绩(触发次数/1·5·10 日平均收益/5 日胜率), 用于回答『金叉历史胜算如何』『超卖后平均跌多少』。窗口函数单扫 8.5M 行 ~8s, 服务端 30min 缓存。", {}, (arg) => {
  return signal_stats_payload();
};

tool "daily_picks", "查今日精选: 当日带信号票按「信号数×量比×市值」打分取 Top 8, 附每只的量比/市值。10min 缓存。", {}, (arg) => {
  return picks_payload();
};

tool "paper_portfolio", "查模拟仓: 当前持仓(成本/现价/浮动盈亏/是否触发止损止盈/凯利仓位建议)+ 已平仓数 + 挂单 + 持仓两两相关性矩阵(60日日收益), 复用它实时行情通道。返回 total_pnl/total_pnl_pct/cash/equity。", {}, (arg) => {
  return paper_payload();
};

tool "data_freshness", "查数据新鲜度: K线最新交易日/资产快照 updated_at/模拟仓 updated_at, 用于回答「数据是不是最新的」「哪份数据停了」。", {}, (arg) => {
  return freshness_payload();
};
